component Backedge {
    state<string?> name = "Ada";

    void clear_name() {
        name = null;
    }

    void in_while() {
        if (name != null) {
            while (name.length > 0) {
                name = null;
            }
        }
    }

    void in_for() {
        if (name != null) {
            for (int i = 0; i < 3; i++) {
                console.log(name.length);
                name = null;
            }
        }
    }

    void in_do_while() {
        if (name != null) {
            do {
                console.log(name.length);
                clear_name();
            } while (name != null);
        }
    }

    void after_loop() {
        if (name != null) {
            for (int i = 0; i < 3; i++) {
                clear_name();
            }
            console.log(name.length);
        }
    }

    view {
        <p>"backedge"</p>
    }
}
